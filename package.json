{
  "name": "homebase",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Customizable self-hosted dashboard: tabs, groups, resizable tiles, live app stats and camera feeds",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "tsx --test server/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/http-proxy": "^11.6.4",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
